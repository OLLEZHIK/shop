// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Core entities
model City {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  country   String
  locale    String
  districts District[]
}

model District {
  id         Int        @id @default(autoincrement())
  cityId     Int
  name       String
  slug       String     @unique
  city       City       @relation(fields: [cityId], references: [id])
  businesses Business[]
}

model Breed {
  id         Int         @id @default(autoincrement())
  name       String
  slug       String      @unique
  sizeClass  SizeClass
  coatNotes  String?
  priceItems PriceItem[]
}

enum SizeClass {
  MINI
  SMALL
  MEDIUM
  LARGE
  XL
}

// Business model (generalized from the grooming-only Salon model)
model Business {
  id           Int              @id @default(autoincrement())
  name         String
  slug         String           @unique
  category     BusinessCategory
  address      String
  districtId   Int?
  lat          Float?
  lng          Float?
  phone        String?
  email        String?
  website      String?
  openingHours Json?
  animals      String[]
  specialties  String[]
  status       BusinessStatus   @default(DRAFT)
  featured     Boolean          @default(false)
  verifiedAt   DateTime?
  sourceUrls   String[]
  notes        String?
  photoUrls    String[]         @default([])
  district     District?        @relation(fields: [districtId], references: [id])
  priceItems   PriceItem[]
  clickEvents  ClickEvent[]
  reviews      Review[]
}

enum BusinessCategory {
  GROOMING
  VET_CLINIC
  PET_HOTEL
  PET_SHOP
  DOG_TRAINING
  PET_SITTING
}

enum BusinessStatus {
  DRAFT
  PUBLISHED
  REMOVED
}

model Review {
  id         Int          @id @default(autoincrement())
  businessId Int
  authorName String
  rating     Int // 1-5
  comment    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  business   Business     @relation(fields: [businessId], references: [id])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

// Services and pricing
model Service {
  id         Int         @id @default(autoincrement())
  name       String
  slug       String      @unique
  priceItems PriceItem[]
}

model PriceItem {
  id         Int        @id @default(autoincrement())
  businessId Int
  serviceId  Int
  sizeClass  SizeClass?
  breedId    Int?
  priceFrom  Decimal
  priceTo    Decimal?
  currency   String     @default("EUR")
  sourceUrl  String
  observedAt DateTime
  business   Business   @relation(fields: [businessId], references: [id])
  service    Service    @relation(fields: [serviceId], references: [id])
  breed      Breed?     @relation(fields: [breedId], references: [id])
}

// Analytics
model ClickEvent {
  id           Int       @id @default(autoincrement())
  businessId   Int
  type         ClickType
  page         String
  referrerHost String?
  createdAt    DateTime  @default(now())
  business     Business  @relation(fields: [businessId], references: [id])
}

enum ClickType {
  CALL
  WEB
  ROUTE
  EMAIL
}
